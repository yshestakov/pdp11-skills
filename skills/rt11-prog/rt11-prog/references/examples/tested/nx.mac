.MCALL	.DRDEF
	.DRDEF	NX,377,0,0,0,0
	.DRPTR
	.DREST	CLASS=DVC.NL
	.DRBEG	NX
	MOV	NXCQE,R5
	TST	6(R5)
	BMI	NXEXIT
	BIS	#EOF$,@-(R5)
	BR	NXEXIT
	RTS	PC
NXINT::
NXEXIT::.DRFIN	NX
	.DREND	NX
.END
